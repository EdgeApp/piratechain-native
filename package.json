{
  "name": "piratechain-native",
  "version": "0.0.1",
  "description": "React Native wrapper for the Pirate Unified Wallet native SDK surfaces",
  "keywords": [
    "react-native",
    "pirate-chain",
    "cryptocurrency",
    "wallet",
    "privacy",
    "shielded"
  ],
  "homepage": "https://github.com/PirateNetwork/Pirate-Unified-Light-Wallet/tree/main/bindings/react-native-pirate-wallet#readme",
  "bugs": {
    "url": "https://github.com/PirateNetwork/Pirate-Unified-Light-Wallet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EdgeApp/piratechain-native.git"
  },
  "author": "Pirate Chain Contributors",
  "license": "MIT",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "files": [
    "android/build.gradle",
    "android/consumer-rules.pro",
    "android/src/main/AndroidManifest.xml",
    "android/src/main/java/",
    "ios/PirateWalletReactNative.m",
    "ios/PirateWalletReactNative.swift",
    "src/",
    "scripts/",
    "test/",
    "LICENSE-MIT",
    "README.md",
    "package.json",
    "react-native.config.js",
    "react-native-pirate-wallet.podspec"
  ],
  "scripts": {
    "test": "nyc mocha",
    "test:seed": "node test/smoke.js",
    "verify:package": "node scripts/verify-package.js",
    "prepare:native": "node scripts/assemble-ios-framework.js",
    "prepack": "node scripts/verify-package.js --publish-layout",
    "verify": "npm run verify:package && npm run test:seed && npm test",
    "build-native-host": "node -r sucrase/register ./scripts/build-native-host.ts",
    "smoke-node": "node -r sucrase/register ./scripts/smoke-node.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "react-native": ">=0.71.0 <1.0.0"
  },
  "optionalDependencies": {
    "react-native-pirate-wallet-android": "0.3.6",
    "react-native-pirate-wallet-android-x86_64": "0.3.6",
    "react-native-pirate-wallet-ios-device": "0.3.6",
    "react-native-pirate-wallet-ios-simulator-arm64": "0.3.6",
    "react-native-pirate-wallet-ios-simulator-x86_64": "0.3.6"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "chai": "^4.3.10",
    "mocha": "^10.4.0",
    "nyc": "^15.1.0",
    "sucrase": "^3.35.0",
    "typescript": "^5.4.5"
  }
}
